APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# GPU training workers. Generate with: php artisan training:token
# Empty means the worker routes refuse with 503 -- a half-configured
# deployment fails closed rather than open.
TRAINING_WORKER_TOKEN=

# Optional: a URL on the GPU host that accepts a training job and starts it,
# the same way a model endpoint accepts a prediction. Without it, a worker must
# poll /api/training/worker/claim instead.
TRAINING_TRAINER_URL=

# What the trainer should report back to. Defaults to APP_URL; set it when the
# GPU host reaches this server by a different name than the browser does.
TRAINING_CALLBACK_URL=

# First administrator, created by `php artisan db:seed`. Leave the password
# empty and the seeder generates one and prints it once.
SEED_ADMIN_EMAIL=admin@brin.go.id
SEED_ADMIN_PASSWORD=

# Optional model catalogue URL; administrators can also enter it in the web form.
AI_MODEL_SERVER_BASE_URL=
