[Unit]
Description=DeepCT dedicated production assistant queue worker
After=network.target deepct-assistant-ollama.service
Wants=deepct-assistant-ollama.service

[Service]
Type=simple
User=jihyo
WorkingDirectory=/var/www/deepct-ai
ExecStart=/usr/bin/php artisan queue:work llm --queue=llm --timeout=300 --tries=1 --memory=256
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
