[Unit]
Description=DeepCT dedicated CPU assistant Ollama
After=network.target

[Service]
Type=simple
User=ollama
Group=ollama
Environment="OLLAMA_HOST=127.0.0.1:11436"
Environment="OLLAMA_MODELS=/usr/share/ollama/.ollama/models"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
Environment="OLLAMA_KEEP_ALIVE=0"
Environment="OLLAMA_LLM_LIBRARY=cpu"
Environment="CUDA_VISIBLE_DEVICES=-1"
Environment="ROCR_VISIBLE_DEVICES=-1"
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=5
CPUQuota=200%
Nice=10
TasksMax=128
# Configured defense only: the current Pi kernel has no memory controller.
# MemoryMax is NOT enforced there; measure process RSS during the full canary.
MemoryMax=3G

[Install]
WantedBy=multi-user.target
