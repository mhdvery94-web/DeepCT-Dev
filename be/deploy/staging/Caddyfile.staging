{
	admin off
	auto_https off
}

# Existing Pi public TLS tunnel can target this gateway after route validation.
http://127.0.0.1:8003 {
	bind 127.0.0.1
	handle_path /staging/* {
		reverse_proxy 100.85.94.74:8001
	}
	handle /staging {
		respond "Not found" 404
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
