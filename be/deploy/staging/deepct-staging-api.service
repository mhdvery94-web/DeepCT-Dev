[Unit]
Description=DeepCT isolated staging API
After=network-online.target mariadb.service

[Service]
User=jihyo
WorkingDirectory=/home/jihyo/deepct-staging/app
ExecStart=/usr/bin/php -d memory_limit=512M artisan octane:start --server=roadrunner --host=100.85.94.74 --port=8001 --workers=2 --max-requests=250
Restart=on-failure
RestartSec=3
MemoryMax=768M
MemorySwapMax=0
CPUQuota=150%
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
