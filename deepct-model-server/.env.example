DEEPCT_MODELS_ROOT=/path/to/deepct-models
DEEPCT_ACTIVATION_FILE=/path/to/deepct-state/activation.json
DEEPCT_INFERENCE_TOKEN=
DEEPCT_MANAGEMENT_TOKEN=
# Exact allowed browser origins, comma-separated; no wildcard credentials.
DEEPCT_UPLOAD_ORIGINS=
# Trusted operator budgets. Leave blank until Task 6 containment/GPU validation.
DEEPCT_COMPATIBILITY_GPU_BYTES=
DEEPCT_COMPATIBILITY_ADDRESS_BYTES=
# Shared local flock file, same path for every GPU participant. Parent must exist.
DEEPCT_GPU_LEASE_PATH=
# Optional, separate bearer; empty disables the private assistant route.
# Opt-in bounded topic classifier; leave false until factual/API acceptance.
DEEPCT_ASSISTANT_METADATA_MODE=false
DEEPCT_ASSISTANT_TOKEN=
# Required free VRAM for admission; nvidia-smi GPU0 must report real capacity.
DEEPCT_ASSISTANT_GPU_BYTES=
DEEPCT_ASSISTANT_TIMEOUT_SECONDS=180
DEEPCT_ASSISTANT_CLEANUP_SECONDS=10
# Explicitly enable only with the existing /predict/{model_name} ingress rewrite.
DEEPCT_LEGACY_PROXY_ENABLED=false
# Empty preserves the original legacy no-auth contract; otherwise require/forward it.
DEEPCT_LEGACY_INFERENCE_TOKEN=
