DEEPCT_MODELS_ROOT=/path/to/deepct-models
DEEPCT_ACTIVATION_FILE=/path/to/deepct-state/activation.json
DEEPCT_INFERENCE_TOKEN=
DEEPCT_MANAGEMENT_TOKEN=
