# Repository-wide ignores.
# `be/.gitignore` and `fe/.gitignore` cover their own build output, vendor
# directories and secrets; this file only handles what sits at the root or
# spans both.

# --- Secrets -----------------------------------------------------------------
# be/.gitignore already excludes be/.env, but be explicit: an APP_KEY and a
# database password live in there and must never be committed.
.env
.env.*
!.env.example

# --- Large binaries ----------------------------------------------------------
# Trained model weights (~88 MB). Git handles large binaries badly and GitHub
# rejects files over 100 MB. Keep the weights alongside the repo, not in it.
#
# It is uploaded to the Kaggle/Colab notebook at runtime, not read by Laravel.
# If it must be versioned, use Git LFS:
#   git lfs install && git lfs track "*.h5"
*.h5
*.hdf5
*.keras
*.ckpt
*.pb

# RoadRunner server binary (~64 MB). Reinstall instead of committing:
#   php artisan octane:install --server=roadrunner
rr.exe
rr

# Arsip proyeksi BRIN dan keluaran percobaan (~93 MB). Dua alasan, dan yang
# kedua lebih penting daripada ukurannya: ini data penelitian yang belum
# diterbitkan, dan seluruh rancangan sistem ini bertumpu pada janji bahwa ia
# tidak berpindah ke luar kendali institusi. Sebuah repositori yang suatu hari
# memperoleh remote akan mengingkari janji itu tanpa ada yang menyadarinya.
#
# Berkasnya tetap di tempatnya di samping repo, bukan di dalamnya.
Examples ZIP/

# ImageJ (~109 MB), aplikasi pihak ketiga yang dipasang di samping repo.
# Melewati batas 100 MB GitHub dan dapat diunduh ulang kapan saja.
ImageJ/

# --- OS / editor -------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.idea/
.vscode/
*.swp

# --- Scratch -----------------------------------------------------------------
*.tmp
*.bak

# Kaggle notebook exports that carry an ngrok auth token in plain text. It is a
# credential for the tunnel account, not source code, and it must not travel
# with the repository.
#
# The tracked inference script reads its token from environment/Kaggle secrets.
#
# `script-deepct.py` is the old name, which did keep its token. Nothing on this
# machine answers to it now, and the line stays so a stale copy cannot arrive.
script-deepct.py
scripts/*-secret.py

# Byte-code beside the Kaggle scripts, now that those scripts are tracked.
__pycache__/
*.pyc

# Personal connection helpers. `koneksi-vps.bat` carries a server address and
# is a local convenience, not part of the project.
koneksi-vps.bat
*.local.bat

# Berkas kunci Word (`~$nama.docx`). Ia muncul selama dokumen terbuka dan
# sempat ikut ter-commit ketika naskah sedang dibuka di Word.
~$*

# Local/generated agent instructions and retired non-application material.
AGENTS.md
CLAUDE.md
/.kilo/
/stitch/
/proposal/
/models-ai/
/Images/
